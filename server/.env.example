# Picks the database outright. Leave unset to build a MySQL URL from the
# DB_* variables below.
#   MySQL:  mysql+mysqlconnector://root:@localhost/portfolio_manager
#   SQLite: sqlite:///dev.db
DATABASE_URL=

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Unset is tolerated for local dev, but sessions then die on every restart.
SECRET_KEY=

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio_manager
# Comma-separated browser origins allowed to reach this server. Deployed,
# these have to name the frontend's own origins (the Vercel domains), NOT
# this server's: the browser addresses Vercel, Vercel proxies here, and the
# Origin header that arrives is the one the page was loaded from.
#
# Entries accept `*`, because Vercel gives every deployment and every branch
# its own hostname, so an enumerated list goes stale on the next push:
#   https://treetop.vercel.app,https://treetop-*.vercel.app
#
# Getting it wrong fails the quote feed and almost nothing else, because
# Engine.IO only checks Origin when the browser sends one - which it does
# on the feed's POSTs and not on its GETs. The visible symptom is half the
# /socket.io requests answering 400 "Not an accepted origin" while the
# other half succeed, and a feed that reconnects forever. The boot log
# prints what this parsed to.
CORS_ORIGINS=http://localhost:5173

# Set to 1 only if the browser talks to this server on a different domain
# than the page it loaded. It sends the session cookie as
# SameSite=None; Secure.
#
# The deployment does NOT need this: vercel.json rewrites /api and
# /socket.io to this server, so the browser only ever addresses its own
# origin and the cookie stays first-party. That matters because a
# third-party cookie is blocked outright by Safari and is being phased out
# by Chrome - with the client pointed straight at this server, logging in
# appeared to work and then every request came back 401.
#
# Secure also requires HTTPS, so turning this on locally breaks sign-in.
CROSS_SITE_COOKIE=

# How much this server says about itself. INFO logs one line per request
# with its status and duration; WARNING keeps only the slow ones, the 500s,
# and the background work that failed.
LOG_LEVEL=INFO

# Set to false to stop the background thread that fills conditional orders
# and redeems matured bonds. It is the only switch that keeps this process
# from calling the market data feed on a timer, which is why the test suite
# turns it off - leave it alone otherwise, or nothing ever fills.
START_LIMIT_ORDER_POLLER=
