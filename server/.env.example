# Picks the database outright. Leave unset to build a MySQL URL from the
# DB_* variables below.
#   MySQL:  mysql+mysqlconnector://root:@localhost/portfolio_manager
#   SQLite: sqlite:///dev.db
DATABASE_URL=

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Unset is tolerated for local dev, but sessions then die on every restart.
SECRET_KEY=

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio_manager
CORS_ORIGINS=http://localhost:5173

# Set to 1 only where the frontend is served from a different domain than
# this server - a deployment, not local development. It sends the session
# cookie as SameSite=None; Secure, without which the browser withholds it
# from cross-site requests and every authenticated call fails as 401.
# Secure requires HTTPS, so turning this on locally breaks logging in.
CROSS_SITE_COOKIE=
