# Origin of the backend, with no trailing slash and no /api suffix:
#   https://portfolio-manager.up.railway.app
#
# Leave it unset for local development. Vite's proxy (see vite.config.ts)
# forwards /api and /socket.io to localhost:5000, so relative URLs already
# reach the right place - setting this locally would bypass the proxy.
#
# Vite inlines this at build time, so a deployed frontend has to be rebuilt
# after changing it. It is also visible in the shipped bundle: put the
# backend's public URL here and nothing secret.
VITE_API_URL=
