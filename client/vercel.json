{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-production-bf98.up.railway.app/api/:path*"
    },
    {
      "source": "/socket.io",
      "destination": "https://api-production-bf98.up.railway.app/socket.io/"
    },
    {
      "source": "/socket.io/",
      "destination": "https://api-production-bf98.up.railway.app/socket.io/"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://api-production-bf98.up.railway.app/socket.io/:path*"
    },
    {
      "comment": "Client-side routing: any path that isn't the API, the socket, or a real file is a route this app resolves itself. Without this, opening /trade/stock/NVDA directly - or reloading on it - would 404 at the edge before the app ever loaded.",
      "source": "/((?!api/|socket.io).*)",
      "destination": "/index.html"
    }
  ]
}
